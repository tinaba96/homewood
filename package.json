{
  "name": "homewood",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply homewood --local",
    "db:migrate:remote": "wrangler d1 migrations apply homewood --remote",
    "deploy": "wrangler deploy && wrangler d1 migrations apply homewood --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
